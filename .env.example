# ==============================================================================
# SIH 2026 — PROBLEM STATEMENT 80: ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development. Never commit sensitive credentials.
# ==============================================================================

# Application Environment
ENV=development
LOG_LEVEL=info
DEBUG=true

# FastAPI Backend Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Configuration Paths
CONFIG_FILE=config/system.yaml
DATA_REGISTRY_FILE=data/source_registry.yaml

# Data Directories
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
CHECKPOINTS_DIR=artifacts/checkpoints
VERIFICATION_DIR=artifacts/verification

# NWP Data Access Mode: "NCUM" (authorized) or "GFS_FALLBACK" (public fallback)
NWP_SOURCE=GFS_FALLBACK

# Atmospheric Analysis Mode: "IMDAA" (authorized) or "ERA5_FALLBACK" (public fallback)
ATMOSPHERIC_SOURCE=ERA5_FALLBACK

# Microsoft ClimaX Foundation Model
CLIMAX_WEIGHTS_PATH=artifacts/checkpoints/climax_backbone.pt
USE_FOUNDATION_FALLBACK_IF_UNAVAILABLE=true

# CDS API Credentials (for ERA5 fallback download if configured)
# CDS_API_URL=https://cds.climate.copernicus.eu/api/v2
# CDS_API_KEY=your_cds_api_key_here
